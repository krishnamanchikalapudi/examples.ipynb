        <mxCell id="QTmaP2FIq1BWrvmet0MQ-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;verticalAlign=bottom;" value="Main components of AI agent" vertex="1">
